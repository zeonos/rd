# Public hostname. Its DNS A/AAAA records must point at this server
# and must NOT be proxied by Cloudflare (grey cloud / "DNS only").
DOMAIN=rd.sfohosting.dk

# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# Generated by setup.sh - keep secret
POSTGRES_PASSWORD=change-me

# First admin account, created on first API start if no user exists.
# Leave ADMIN_PASSWORD empty to have the API print a random one in its log.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional: ntfy.sh topic URL for login alerts, e.g. https://ntfy.sh/my-secret-topic
ALERT_NTFY_URL=

# Alert when a device has been offline this many minutes (0 = off).
ALERT_OFFLINE_MINUTES=10
# Alert when a disk in a device inventory has less free space than this (percent, 0 = off)
ALERT_DISK_PERCENT=10

# Backups (backup.sh): optional off-site copy via rsync over SSH, e.g. a Hetzner
# Storage Box: u123456@u123456.your-storagebox.de:rd-backups  (port 23)
BACKUP_REMOTE=
BACKUP_REMOTE_PORT=23
BACKUP_KEEP_DAYS=14

# hbbs/hbbr image. Default: our build with WebSocket registration (rendezvous/).
# Upstream without WebSocket registration: rustdesk/rustdesk-server:latest
HBBS_IMAGE=ghcr.io/zeonos/rd-hbbs:latest

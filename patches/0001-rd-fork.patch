+                          color: Rd.ink)),
+                  Row(children: [
+                    Text(formatID(d.id),
+                        style: Rd.monoText.copyWith(fontSize: 15)),
+                    IconButton(
+                      tooltip: 'Copy ID',
+                      iconSize: 16,
+                      onPressed: () =>
+                          Clipboard.setData(ClipboardData(text: d.id)),
+                      icon: const Icon(Icons.copy, color: Rd.muted),
+                    ),
+                  ]),
+                  const SizedBox(height: 16),
+                  ElevatedButton.icon(
+                    style: Rd.primary.copyWith(
+                        minimumSize:
+                            const MaterialStatePropertyAll(Size(0, 48))),
+                    onPressed: () => _connect(d),
+                    icon: const Icon(Icons.desktop_windows_outlined, size: 20),
+                    label: const Text('Connect'),
+                  ),
+                  if (!d.unattended)
+                    const Padding(
+                      padding: EdgeInsets.only(top: 8),
+                      child: Text(
+                          'No unattended password reported yet: you may be asked for one.',
+                          style: TextStyle(fontSize: 13, color: Rd.muted)),
+                    ),
+                  const SizedBox(height: 12),
+                  Row(children: [
+                    Expanded(
+                        child: _action(Icons.folder_outlined, 'Files',
+                            () => _connect(d, files: true))),
+                    const SizedBox(width: 8),
+                    Expanded(
+                        child: _action(Icons.terminal, 'Run script',
+                            () => rdRunScript(context,
+                                deviceId: d.id, name: d.name))),
+                  ]),
+                  const SizedBox(height: 8),
+                  Row(children: [
+                    Expanded(
+                        child: _action(
+                            Icons.restart_alt,
+                            'Reboot',
+                            () => rdConfirmPower(context,
+                                deviceId: d.id,
+                                name: d.name,
+                                action: 'reboot',
+                                online: d.online))),
+                    const SizedBox(width: 8),
+                    Expanded(
+                        child: _action(
+                            Icons.power_settings_new,
+                            'Shut down',
+                            () => rdConfirmPower(context,
+                                deviceId: d.id,
+                                name: d.name,
+                                action: 'shutdown',
+                                online: d.online))),
+                  ]),
+                  const SizedBox(height: 24),
+                  _fact('Location', d.location),
+                  _fact('System', d.os),
+                  _fact('User', d.username),
+                  _fact('Host name', d.hostname),
+                  _fact('Public IP', d.ip, mono: true),
+                  _fact('RD build', d.build > 0 ? '${d.build}' : ''),
+                  _fact('Last seen', d.lastSeenText),
+                ],
+              ),
+            ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      color: Rd.mist,
+      child: Column(children: [
+        _header(),
+        Expanded(
+          child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+            _sidebar(),
+            Expanded(child: _list()),
+            _detail(),
+          ]),
+        ),
+      ]),
+    );
+  }
+}
diff --git a/client/flutter/lib/rd/mobile.dart b/client/flutter/lib/rd/mobile.dart
new file mode 100644
index 0000000..b7dd341
--- /dev/null
+++ b/client/flutter/lib/rd/mobile.dart
@@ -0,0 +1,408 @@
+// Android/iOS: sign-in, then the device list by location.
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/formatter/id_formatter.dart';
+import 'package:flutter_hbb/models/ab_model.dart';
+import 'package:get/get.dart';
+
+import 'actions.dart';
+import 'api.dart';
+import 'sign_in.dart';
+import 'theme.dart';
+
+class RdMobileShell extends StatelessWidget {
+  const RdMobileShell({Key? key}) : super(key: key);
+
+  @override
+  Widget build(BuildContext context) {
+    return Obx(() => gFFI.userModel.userName.value.isEmpty
+        ? const Scaffold(
+            backgroundColor: Rd.mist,
+            body: SafeArea(child: RdSignInPage()))
+        : const RdMobileHome());
+  }
+}
+
+class RdMobileHome extends StatefulWidget {
+  const RdMobileHome({Key? key}) : super(key: key);
+
+  @override
+  State<RdMobileHome> createState() => _RdMobileHomeState();
+}
+
+class _RdMobileHomeState extends State<RdMobileHome> {
+  final _search = TextEditingController();
+  List<RdDevice> _devices = [];
+  bool _loading = true;
+  String? _error;
+  String _location = '';
+  Timer? _timer;
+
+  @override
+  void initState() {
+    super.initState();
+    _load(pullAb: true);
+    _timer = Timer.periodic(const Duration(seconds: 20), (_) => _load());
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    _search.dispose();
+    super.dispose();
+  }
+
+  Future<void> _load({bool pullAb = false}) async {
+    if (RdApi.token.isEmpty) {
+      Future.delayed(const Duration(milliseconds: 400), () {
+        if (mounted) _load(pullAb: pullAb);
+      });
+      return;
+    }
+    if (pullAb) {
+      gFFI.abModel.pullAb(force: ForcePullAb.listAndCurrent, quiet: true);
+    }
+    try {
+      final list = await RdApi.devices();
+      if (!mounted) return;
+      setState(() {
+        _devices = list;
+        _loading = false;
+        _error = null;
+      });
+    } on RdApiError catch (e) {
+      if (!mounted) return;
+      if (e.unauthorized) {
+        await gFFI.userModel.reset(resetOther: true);
+        return;
+      }
+      setState(() {
+        _loading = false;
+        _error = e.message;
+      });
+    } catch (_) {
+      if (!mounted) return;
+      setState(() {
+        _loading = false;
+        _error = 'Could not reach the RD server.';
+      });
+    }
+  }
+
+  bool _inLocation(RdDevice d) =>
+      _location.isEmpty ||
+      d.location == _location ||
+      d.location.startsWith('$_location/');
+
+  List<RdDevice> get _visible {
+    final q = _search.text.trim().toLowerCase();
+    final qDigits = q.replaceAll(' ', '');
+    final l = _devices.where((d) {
+      if (!_inLocation(d)) return false;
+      if (q.isEmpty) return true;
+      return d.name.toLowerCase().contains(q) ||
+          d.id.contains(qDigits) ||
+          d.username.toLowerCase().contains(q) ||
+          d.ip.contains(q);
+    }).toList();
+    l.sort((a, b) {
+      if (a.online != b.online) return a.online ? -1 : 1;
+      return a.name.toLowerCase().compareTo(b.name.toLowerCase());
+    });
+    return l;
+  }
+
+  List<String> get _locations {
+    final set = <String>{};
+    for (final d in _devices) {
+      final parts = d.location.split('/');
+      for (var i = 1; i <= parts.length; i++) {
+        set.add(parts.sublist(0, i).join('/'));
+      }
+    }
+    return set.toList()..sort((a, b) => a.toLowerCase().compareTo(b.toLowerCase()));
+  }
+
+  void _openDevice(RdDevice d) {
+    showModalBottomSheet(
+      context: context,
+      showDragHandle: true,
+      builder: (ctx) => SafeArea(
+        child: Padding(
+          padding: const EdgeInsets.fromLTRB(20, 0, 20, 20),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              Row(children: [
+                Rd.statusDot(d.online),
+                const SizedBox(width: 8),
+                Text(d.online ? 'Online' : 'Offline, ${d.lastSeenText}',
+                    style: TextStyle(
+                        fontSize: 14,
+                        fontWeight: FontWeight.w600,
+                        color: d.online ? Rd.online : Rd.muted)),
+              ]),
+              const SizedBox(height: 6),
+              Text(d.name,
+                  style: const TextStyle(
+                      fontSize: 22, fontWeight: FontWeight.w600, color: Rd.ink)),
+              Text('${formatID(d.id)}  ·  ${d.location}',
+                  style: const TextStyle(fontSize: 14, color: Rd.muted)),
+              if (d.os.isNotEmpty || d.username.isNotEmpty)
+                Padding(
+                  padding: const EdgeInsets.only(top: 4),
+                  child: Text(
+                      [d.os, if (d.username.isNotEmpty) 'User: ${d.username}']
+                          .where((e) => e.isNotEmpty)
+                          .join('\n'),
+                      style: const TextStyle(fontSize: 14, color: Rd.body)),
+                ),
+              const SizedBox(height: 16),
+              ElevatedButton.icon(
+                style: Rd.primary.copyWith(
+                    minimumSize: const MaterialStatePropertyAll(Size(0, 52))),
+                onPressed: () {
+                  Navigator.of(ctx).pop();
+                  connect(context, d.id);
+                },
+                icon: const Icon(Icons.desktop_windows_outlined),
+                label: const Text('Connect'),
+              ),
+              const SizedBox(height: 8),
+              Row(children: [
+                Expanded(
+                  child: OutlinedButton.icon(
+                    style: Rd.secondary.copyWith(
+                        minimumSize: const MaterialStatePropertyAll(Size(0, 48))),
+                    onPressed: () {
+                      Navigator.of(ctx).pop();
+                      connect(context, d.id, isFileTransfer: true);
+                    },
+                    icon: const Icon(Icons.folder_outlined, size: 18),
+                    label: const Text('Files'),
+                  ),
+                ),
+                const SizedBox(width: 8),
+                Expanded(
+                  child: OutlinedButton.icon(
+                    style: Rd.secondary.copyWith(
+                        minimumSize: const MaterialStatePropertyAll(Size(0, 48))),
+                    onPressed: () {
+                      Navigator.of(ctx).pop();
+                      rdRunScript(context, deviceId: d.id, name: d.name);
+                    },
+                    icon: const Icon(Icons.terminal, size: 18),
+                    label: const Text('Script'),
+                  ),
+                ),
+              ]),
+              const SizedBox(height: 8),
+              Row(children: [
+                Expanded(
+                  child: OutlinedButton.icon(
+                    style: Rd.secondary.copyWith(
+                        minimumSize: const MaterialStatePropertyAll(Size(0, 48))),
+                    onPressed: () {
+                      Navigator.of(ctx).pop();
+                      rdConfirmPower(context,
+                          deviceId: d.id,
+                          name: d.name,
+                          action: 'reboot',
+                          online: d.online);
+                    },
+                    icon: const Icon(Icons.restart_alt, size: 18),
+                    label: const Text('Reboot'),
+                  ),
+                ),
+                const SizedBox(width: 8),
+                Expanded(
+                  child: OutlinedButton.icon(
+                    style: Rd.secondary.copyWith(
+                        minimumSize: const MaterialStatePropertyAll(Size(0, 48))),
+                    onPressed: () {
+                      Navigator.of(ctx).pop();
+                      rdConfirmPower(context,
+                          deviceId: d.id,
+                          name: d.name,
+                          action: 'shutdown',
+                          online: d.online);
+                    },
+                    icon: const Icon(Icons.power_settings_new, size: 18),
+                    label: const Text('Shut down'),
+                  ),
+                ),
+              ]),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _tile(RdDevice d) {
+    return Material(
+      color: Colors.white,
+      child: InkWell(
+        onTap: () => _openDevice(d),
+        child: Container(
+          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
+          decoration: const BoxDecoration(
+              border: Border(bottom: BorderSide(color: Color(0xFFE6ECEA)))),
+          child: Row(children: [
+            Rd.statusDot(d.online),
+            const SizedBox(width: 14),
+            Expanded(
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text(d.name,
+                      overflow: TextOverflow.ellipsis,
+                      style: const TextStyle(
+                          fontSize: 16,
+                          fontWeight: FontWeight.w600,
+                          color: Rd.ink)),
+                  const SizedBox(height: 2),
+                  Text(
+                      _location.isEmpty
+                          ? '${d.location}  ·  ${d.lastSeenText}'
+                          : d.lastSeenText,
+                      overflow: TextOverflow.ellipsis,
+                      style: const TextStyle(fontSize: 13, color: Rd.muted)),
+                ],
+              ),
+            ),
+            Text(formatID(d.id), style: Rd.monoText.copyWith(fontSize: 13)),
+          ]),
+        ),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final rows = _visible;
+    final locs = _locations;
+    return Scaffold(
+      backgroundColor: Rd.mist,
+      appBar: AppBar(
+        backgroundColor: Rd.ink,
+        foregroundColor: Colors.white,
+        titleSpacing: 16,
+        title: Row(children: [
+          Rd.mark(26),
+          const SizedBox(width: 10),
+          const Text('RD',
+              style: TextStyle(fontSize: 18, fontWeight: FontWeight.w600)),
+        ]),
+        actions: [
+          PopupMenuButton<String>(
+            icon: const Icon(Icons.account_circle_outlined),
+            onSelected: (v) {
+              if (v == 'signout') gFFI.userModel.logOut();
+            },
+            itemBuilder: (_) => [
+              PopupMenuItem(
+                  enabled: false,
+                  child: Text('Signed in as ${gFFI.userModel.userName.value}')),
+              const PopupMenuItem(value: 'signout', child: Text('Sign out')),
+            ],
+          ),
+        ],
+      ),
+      body: Column(children: [
+        Container(
+          color: Rd.ink,
+          padding: const EdgeInsets.fromLTRB(12, 0, 12, 12),
+          child: TextField(
+            controller: _search,
+            onChanged: (_) => setState(() {}),
+            style: const TextStyle(color: Colors.white, fontSize: 16),
+            cursorColor: Colors.white,
+            decoration: InputDecoration(
+              hintText: 'Search name, ID, user or IP',
+              hintStyle: const TextStyle(color: Rd.onInkMuted),
+              prefixIcon: const Icon(Icons.search, color: Rd.onInkMuted),
+              filled: true,
+              fillColor: Rd.inkRaised,
+              isDense: true,
+              border: OutlineInputBorder(
+                  borderRadius: BorderRadius.circular(10),
+                  borderSide: BorderSide.none),
+            ),
+          ),
+        ),
+        SizedBox(
+          height: 52,
+          child: ListView(
+            scrollDirection: Axis.horizontal,
+            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+            children: [
+              _chip('', 'All'),
+              ...locs.map((l) => _chip(l, l.split('/').last)),
+            ],
+          ),
+        ),
+        if (_error != null)
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 0, 16, 8),
+            child: Text(_error!,
+                style: const TextStyle(fontSize: 14, color: Rd.danger)),
+          ),
+        Expanded(
+          child: RefreshIndicator(
+            color: Rd.fjord,
+            onRefresh: () => _load(pullAb: true),
+            child: _loading
+                ? ListView(children: const [
+                    Padding(
+                        padding: EdgeInsets.all(40),
+                        child: Center(
+                            child: CircularProgressIndicator(color: Rd.fjord)))
+                  ])
+                : rows.isEmpty
+                    ? ListView(children: [
+                        Padding(
+                          padding: const EdgeInsets.all(32),
+                          child: Text(
+                              _devices.isEmpty
+                                  ? 'No devices yet.'
+                                  : 'No device matches.',
+                              style: const TextStyle(
+                                  fontSize: 15, color: Rd.muted)),
+                        )
+                      ])
+                    : ListView.builder(
+                        itemCount: rows.length,
+                        itemBuilder: (_, i) => _tile(rows[i])),
+          ),
+        ),
+      ]),
+    );
+  }
+
+  Widget _chip(String loc, String label) {
+    final on = _location == loc;
+    final inLoc = _devices
+        .where((d) => loc.isEmpty || d.location == loc || d.location.startsWith('$loc/'))
+        .toList();
+    final online = inLoc.where((d) => d.online).length;
+    return Padding(
+      padding: const EdgeInsets.only(right: 8),
+      child: ChoiceChip(
+        selected: on,
+        onSelected: (_) => setState(() => _location = loc),
+        label: Text('$label  $online/${inLoc.length}'),
+        selectedColor: Rd.fjord,
+        backgroundColor: Colors.white,
+        side: const BorderSide(color: Rd.lineStrong),
+        labelStyle: TextStyle(
+            color: on ? Colors.white : Rd.ink,
+            fontWeight: on ? FontWeight.w600 : FontWeight.w500),
+        showCheckmark: false,
+      ),
+    );
+  }
+}
diff --git a/client/flutter/lib/rd/session_toolbar.dart b/client/flutter/lib/rd/session_toolbar.dart
new file mode 100644
index 0000000..899fd26
--- /dev/null
+++ b/client/flutter/lib/rd/session_toolbar.dart
@@ -0,0 +1,280 @@
+// Fixed toolbar above the remote screen: screens, Ctrl+Alt+Del, scale,
+// quality, and the less frequent actions under More.
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/shared_state.dart';
+import 'package:flutter_hbb/common/widgets/dialog.dart';
+import 'package:flutter_hbb/consts.dart';
+import 'package:flutter_hbb/models/model.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:get/get.dart';
+
+import 'actions.dart';
+import 'theme.dart';
+
+const double _kHeight = 48;
+
+/// The RD toolbar replaces RustDesk's floating one in remote sessions.
+const bool rdSessionToolbarShown = true;
+
+/// Height the toolbar takes from the remote canvas (remote windows only).
+double rdSessionToolbarHeight() =>
+    desktopType == DesktopType.remote ? _kHeight : 0;
+
+class RdSessionToolbar extends StatefulWidget {
+  final String id;
+  final FFI ffi;
+  const RdSessionToolbar({Key? key, required this.id, required this.ffi})
+      : super(key: key);
+
+  @override
+  State<RdSessionToolbar> createState() => _RdSessionToolbarState();
+}
+
+class _RdSessionToolbarState extends State<RdSessionToolbar> {
+  String _scale = '';
+  String _quality = '';
+
+  FFI get ffi => widget.ffi;
+
+  @override
+  void initState() {
+    super.initState();
+    _readSettings();
+  }
+
+  Future<void> _readSettings() async {
+    final s = await bind.sessionGetViewStyle(sessionId: ffi.sessionId) ?? '';
+    final q = await bind.sessionGetImageQuality(sessionId: ffi.sessionId) ?? '';
+    if (mounted) {
+      setState(() {
+        _scale = s;
+        _quality = q;
+      });
+    }
+  }
+
+  Future<void> _setScale(String v) async {
+    await bind.sessionSetViewStyle(sessionId: ffi.sessionId, value: v);
+    await ffi.canvasModel.updateViewStyle();
+    if (mounted) setState(() => _scale = v);
+  }
+
+  Future<void> _setQuality(String v) async {
+    await bind.sessionSetImageQuality(sessionId: ffi.sessionId, value: v);
+    if (mounted) setState(() => _quality = v);
+  }
+
+  void _sendCad() {
+    bind.sessionCtrlAltDel(sessionId: ffi.sessionId);
+    final m = ScaffoldMessenger.maybeOf(context);
+    m?.showSnackBar(const SnackBar(
+      content: Text('Sent Ctrl+Alt+Del'),
+      backgroundColor: Rd.ink,
+      behavior: SnackBarBehavior.floating,
+      width: 260,
+      duration: Duration(seconds: 2),
+    ));
+  }
+
+  void _transferFiles() {
+    final connToken = bind.sessionGetConnToken(sessionId: ffi.sessionId);
+    connect(context, widget.id, isFileTransfer: true, connToken: connToken);
+  }
+
+  String get _name {
+    final pi = ffi.ffiModel.pi;
+    return pi.hostname.isNotEmpty ? pi.hostname : widget.id;
+  }
+
+  Widget _label(String text) => Padding(
+        padding: const EdgeInsets.only(right: 8),
+        child: Text(text,
+            style: const TextStyle(
+                fontFamily: Rd.sans,
+                fontSize: 13,
+                fontWeight: FontWeight.w500,
+                color: Rd.muted)),
+      );
+
+  /// A row of joined toggle buttons.
+  Widget _segments(List<_Seg> segs) {
+    final children = <Widget>[];
+    for (var i = 0; i < segs.length; i++) {
+      final s = segs[i];
+      children.add(Semantics(
+        selected: s.on,
+        button: true,
+        child: Material(
+          color: s.on ? Rd.fjord : Colors.white,
+          child: InkWell(
+            onTap: s.onTap,
+            hoverColor: s.on ? Rd.fjordDark : const Color(0xFFE1E8E6),
+            child: Container(
+              height: 34,
+              constraints: const BoxConstraints(minWidth: 40),
+              padding: const EdgeInsets.symmetric(horizontal: 12),
+              alignment: Alignment.center,
+              decoration: i == 0
+                  ? null
+                  : const BoxDecoration(
+                      border: Border(left: BorderSide(color: Rd.lineStrong))),
+              child: Text(s.label,
+                  style: TextStyle(
+                      fontFamily: Rd.sans,
+                      fontSize: 14,
+                      fontWeight: s.on ? FontWeight.w600 : FontWeight.w500,
+                      color: s.on ? Colors.white : Rd.ink)),
+            ),
+          ),
+        ),
+      ));
+    }
+    return Container(
+      clipBehavior: Clip.antiAlias,
+      decoration: BoxDecoration(
+        border: Border.all(color: Rd.lineStrong),
+        borderRadius: BorderRadius.circular(8),
+      ),
+      child: Row(mainAxisSize: MainAxisSize.min, children: children),
+    );
+  }
+
+  Widget _screens() {
+    return Obx(() {
+      final count = ffi.ffiModel.pi.displays.length;
+      if (count <= 1) return const SizedBox.shrink();
+      int current = 0;
+      try {
+        current = CurrentDisplayState.find(widget.id).value;
+      } catch (_) {}
+      return Row(mainAxisSize: MainAxisSize.min, children: [
+        _label('Screen'),
+        _segments(List.generate(
+            count,
+            (i) => _Seg('${i + 1}', current == i, () {
+                  openMonitorInTheSameTab(i, ffi, ffi.ffiModel.pi);
+                }))),
+        const SizedBox(width: 20),
+      ]);
+    });
+  }
+
+  Widget _more() {
+    return PopupMenuButton<String>(
+      tooltip: 'More',
+      offset: const Offset(0, 40),
+      onSelected: (v) {
+        switch (v) {
+          case 'files':
+            _transferFiles();
+            break;
+          case 'script':
+            rdRunScript(context, deviceId: widget.id, name: _name);
+            break;
+          case 'lock':
+            bind.sessionLockScreen(sessionId: ffi.sessionId);
+            break;
+          case 'reboot':
+            showRestartRemoteDevice(ffi.ffiModel.pi, widget.id,
+                ffi.sessionId, ffi.dialogManager);
+            break;
+        }
+      },
+      itemBuilder: (_) => [
+        const PopupMenuItem(value: 'files', child: Text('Transfer files')),
+        const PopupMenuItem(value: 'script', child: Text('Run script')),
+        const PopupMenuItem(value: 'lock', child: Text('Lock screen')),
+        PopupMenuItem(
+            value: 'reboot',
+            child: Text('Reboot $_name',
+                style: const TextStyle(color: Rd.danger))),
+      ],
+      child: Container(
+        height: 36,
+        padding: const EdgeInsets.symmetric(horizontal: 12),
+        decoration: BoxDecoration(
+          color: Colors.white,
+          border: Border.all(color: Rd.lineStrong),
+          borderRadius: BorderRadius.circular(8),
+        ),
+        child: const Row(mainAxisSize: MainAxisSize.min, children: [
+          Text('More',
+              style: TextStyle(
+                  fontFamily: Rd.sans,
+                  fontSize: 14,
+                  fontWeight: FontWeight.w500,
+                  color: Rd.ink)),
+          SizedBox(width: 4),
+          Icon(Icons.expand_more, size: 18, color: Rd.ink),
+        ]),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      height: _kHeight,
+      decoration: const BoxDecoration(
+        color: Colors.white,
+        border: Border(bottom: BorderSide(color: Rd.line)),
+      ),
+      padding: const EdgeInsets.symmetric(horizontal: 16),
+      child: Row(children: [
+        Expanded(
+          child: SingleChildScrollView(
+            scrollDirection: Axis.horizontal,
+            child: Row(children: [
+              _screens(),
+              OutlinedButton.icon(
+                style: Rd.secondary.copyWith(
+                    minimumSize: const MaterialStatePropertyAll(Size(0, 36)),
+                    textStyle: const MaterialStatePropertyAll(TextStyle(
+                        fontFamily: Rd.sans,
+                        fontSize: 14,
+                        fontWeight: FontWeight.w600))),
+                onPressed: _sendCad,
+                icon: const Icon(Icons.keyboard_outlined, size: 18),
+                label: const Text('Ctrl+Alt+Del'),
+              ),
+              const SizedBox(width: 20),
+              _label('Scale'),
+              _segments([
+                _Seg('Fit window', _scale == kRemoteViewStyleAdaptive,
+                    () => _setScale(kRemoteViewStyleAdaptive)),
+                _Seg('100%', _scale == kRemoteViewStyleOriginal,
+                    () => _setScale(kRemoteViewStyleOriginal)),
+              ]),
+              const SizedBox(width: 20),
+              _label('Quality'),
+              _segments([
+                _Seg('Best', _quality == kRemoteImageQualityBest,
+                    () => _setQuality(kRemoteImageQualityBest)),
+                _Seg('Balanced', _quality == kRemoteImageQualityBalanced,
+                    () => _setQuality(kRemoteImageQualityBalanced)),
+                _Seg('Fast', _quality == kRemoteImageQualityLow,
+                    () => _setQuality(kRemoteImageQualityLow)),
+              ]),
+            ]),
+          ),
+        ),
+        const SizedBox(width: 12),
+        _more(),
+        const SizedBox(width: 8),
+        OutlinedButton(
+          style: Rd.dangerOutline,
+          onPressed: () => closeConnection(id: widget.id),
+          child: const Text('Disconnect'),
+        ),
+      ]),
+    );
+  }
+}
+
+class _Seg {
+  final String label;
+  final bool on;
+  final VoidCallback onTap;
+  _Seg(this.label, this.on, this.onTap);
+}

diff --git a/client/flutter/lib/rd/actions.dart b/client/flutter/lib/rd/actions.dart
new file mode 100644
index 0000000..6a2096d
--- /dev/null
+++ b/client/flutter/lib/rd/actions.dart
@@ -0,0 +1,248 @@
+// Device actions that go through the RD server's job queue: run a script,
+// reboot, shut down. They work without a session and queue for offline devices.
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+
+import 'api.dart';
+import 'theme.dart';
+
+Future<void> rdConfirmPower(BuildContext context,
+    {required String deviceId,
+    required String name,
+    required String action,
+    required bool online}) async {
+  final label = action == 'shutdown' ? 'Shut down' : 'Reboot';
+  final ok = await showDialog<bool>(
+    context: context,
+    builder: (ctx) => AlertDialog(
+      title: Text('$label $name?'),
+      content: Text(online
+          ? '$name will ${action == 'shutdown' ? 'shut down' : 'restart'} within a few seconds. Anyone signed in on it will lose unsaved work.'
+          : '$name is offline. The ${label.toLowerCase()} is queued and runs when it comes back within 24 hours.'),
+      actions: [
+        TextButton(
+            onPressed: () => Navigator.of(ctx).pop(false),
+            child: const Text('Cancel')),
+        ElevatedButton(
+            style: Rd.primary.copyWith(
+                backgroundColor: const MaterialStatePropertyAll(Rd.danger)),
+            onPressed: () => Navigator.of(ctx).pop(true),
+            child: Text(label)),
+      ],
+    ),
+  );
+  if (ok != true) return;
+  try {
+    await RdApi.power(deviceId, action);
+    _snack(context, '$label sent to $name.');
+  } catch (e) {
+    _snack(context, '$label failed: $e');
+  }
+}
+
+void _snack(BuildContext context, String text) {
+  final m = ScaffoldMessenger.maybeOf(context);
+  if (m == null) return;
+  m.showSnackBar(SnackBar(
+    content: Text(text),
+    backgroundColor: Rd.ink,
+    behavior: SnackBarBehavior.floating,
+    width: 420,
+  ));
+}
+
+Future<void> rdRunScript(BuildContext context,
+    {required String deviceId, required String name}) {
+  return showDialog(
+      context: context,
+      builder: (_) => _RunScriptDialog(deviceId: deviceId, name: name));
+}
+
+class _RunScriptDialog extends StatefulWidget {
+  final String deviceId;
+  final String name;
+  const _RunScriptDialog({required this.deviceId, required this.name});
+
+  @override
+  State<_RunScriptDialog> createState() => _RunScriptDialogState();
+}
+
+class _RunScriptDialogState extends State<_RunScriptDialog> {
+  final _body = TextEditingController();
+  List<RdScript> _scripts = [];
+  int? _scriptId; // null = type a script here
+  String _shell = 'powershell';
+  bool _running = false;
+  String? _error;
+  RdRun? _run;
+  Timer? _poll;
+
+  @override
+  void initState() {
+    super.initState();
+    RdApi.scripts().then((v) {
+      if (mounted) setState(() => _scripts = v);
+    }).catchError((_) {});
+  }
+
+  @override
+  void dispose() {
+    _poll?.cancel();
+    _body.dispose();
+    super.dispose();
+  }
+
+  Future<void> _start() async {
+    if (_scriptId == null && _body.text.trim().isEmpty) {
+      setState(() => _error = 'Type a script, or pick a saved one.');
+      return;
+    }
+    setState(() {
+      _running = true;
+      _error = null;
+      _run = null;
+    });
+    try {
+      final job = await RdApi.runScript(widget.deviceId,
+          scriptId: _scriptId, shell: _shell, body: _body.text);
+      _poll = Timer.periodic(const Duration(seconds: 2), (t) async {
+        try {
+          final r = await RdApi.run(job);
+          if (!mounted) return;
+          setState(() => _run = r);
+          if (r != null && r.finished) {
+            t.cancel();
+            setState(() => _running = false);
+          }
+        } catch (_) {}
+      });
+    } catch (e) {
+      setState(() {
+        _running = false;
+        _error = e.toString();
+      });
+    }
+  }
+
+  String get _statusText {
+    final r = _run;
+    if (r == null) return 'Sending…';
+    switch (r.status) {
+      case 'queued':
+        return 'Waiting for ${widget.name} to pick it up…';
+      case 'sent':
+        return 'Running on ${widget.name}…';
+      case 'success':
+        return 'Finished (exit code ${r.exitCode ?? 0}).';
+      case 'failed':
+        return 'Failed${r.exitCode != null ? ' (exit code ${r.exitCode})' : ''}.';
+      case 'expired':
+        return '${widget.name} did not come online in time.';
+      case 'cancelled':
+        return 'Cancelled.';
+    }
+    return r.status;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final items = <DropdownMenuItem<int?>>[
+      const DropdownMenuItem<int?>(value: null, child: Text('Type a script')),
+      ..._scripts.map((s) => DropdownMenuItem<int?>(
+          value: s.id, child: Text('${s.name} (${s.shell})'))),
+    ];
+    return AlertDialog(
+      title: Text('Run script on ${widget.name}'),
+      content: SizedBox(
+        width: 560,
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Row(children: [
+              Expanded(
+                child: DropdownButtonFormField<int?>(
+                  value: _scriptId,
+                  items: items,
+                  decoration: Rd.field(null),
+                  onChanged: _running
+                      ? null
+                      : (v) => setState(() => _scriptId = v),
+                ),
+              ),
+              if (_scriptId == null) ...[
+                const SizedBox(width: 12),
+                SizedBox(
+                  width: 160,
+                  child: DropdownButtonFormField<String>(
+                    value: _shell,
+                    decoration: Rd.field(null),
+                    items: const [
+                      DropdownMenuItem(
+                          value: 'powershell', child: Text('PowerShell')),
+                      DropdownMenuItem(value: 'cmd', child: Text('cmd')),
+                    ],
+                    onChanged: _running
+                        ? null
+                        : (v) => setState(() => _shell = v ?? 'powershell'),
+                  ),
+                ),
+              ],
+            ]),
+            if (_scriptId == null) ...[
+              const SizedBox(height: 12),
+              TextField(
+                controller: _body,
+                enabled: !_running,
+                minLines: 5,
+                maxLines: 10,
+                style: const TextStyle(fontFamily: Rd.mono, fontSize: 13),
+                decoration: Rd.field('hostname; Get-Date'),
+              ),
+            ],
+            const SizedBox(height: 8),
+            const Text('Runs as SYSTEM. Offline devices run it when they come back, within 24 hours.',
+                style: TextStyle(fontSize: 13, color: Rd.muted)),
+            if (_error != null) ...[
+              const SizedBox(height: 12),
+              Text(_error!, style: const TextStyle(color: Rd.danger)),
+            ],
+            if (_running || _run != null) ...[
+              const SizedBox(height: 16),
+              Text(_statusText,
+                  style: const TextStyle(
+                      fontSize: 14, fontWeight: FontWeight.w500)),
+              if ((_run?.output ?? '').isNotEmpty) ...[
+                const SizedBox(height: 8),
+                Container(
+                  constraints: const BoxConstraints(maxHeight: 260),
+                  decoration: BoxDecoration(
+                      color: Rd.ink, borderRadius: BorderRadius.circular(8)),
+                  padding: const EdgeInsets.all(12),
+                  child: SingleChildScrollView(
+                    child: SelectableText(_run!.output,
+                        style: const TextStyle(
+                            fontFamily: Rd.mono,
+                            fontSize: 12.5,
+                            color: Colors.white)),
+                  ),
+                ),
+              ],
+            ],
+          ],
+        ),
+      ),
+      actions: [
+        TextButton(
+            onPressed: () => Navigator.of(context).pop(),
+            child: Text(_running ? 'Close (keeps running)' : 'Close')),
+        ElevatedButton(
+          style: Rd.primary,
+          onPressed: _running ? null : _start,
+          child: Text(_run == null ? 'Run' : 'Run again'),
+        ),
+      ],
+    );
+  }
+}
diff --git a/client/flutter/lib/rd/api.dart b/client/flutter/lib/rd/api.dart
new file mode 100644
index 0000000..62360d8
--- /dev/null
+++ b/client/flutter/lib/rd/api.dart
@@ -0,0 +1,186 @@
+// Client for the RD server's console API, used with the viewer's login token.
+import 'dart:convert';
+
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+
+import '../utils/http_service.dart' as http;
+
+class RdApiError implements Exception {
+  final int status;
+  final String message;
+  RdApiError(this.status, this.message);
+  bool get unauthorized => status == 401;
+  @override
+  String toString() => message;
+}
+
+class RdDevice {
+  final String id;
+  final String alias;
+  final String hostname;
+  final String username;
+  final String os;
+  final String group;
+  final bool online;
+  final DateTime? lastSeen;
+  final bool unattended;
+  final String ip;
+  final int build;
+
+  RdDevice({
+    required this.id,
+    required this.alias,
+    required this.hostname,
+    required this.username,
+    required this.os,
+    required this.group,
+    required this.online,
+    required this.lastSeen,
+    required this.unattended,
+    this.ip = '',
+    this.build = 0,
+  });
+
+  String get name => alias.isNotEmpty
+      ? alias
+      : (hostname.isNotEmpty ? hostname : id);
+
+  /// "Unassigned" for devices without a location.
+  String get location => group.isEmpty ? RdApi.unassigned : group;
+
+  factory RdDevice.fromJson(Map<String, dynamic> j) => RdDevice(
+        id: (j['id'] ?? '').toString(),
+        alias: (j['alias'] ?? '').toString(),
+        hostname: (j['hostname'] ?? '').toString(),
+        username: (j['username'] ?? '').toString(),
+        os: (j['os'] ?? '').toString(),
+        group: (j['group'] ?? '').toString(),
+        online: j['online'] == true,
+        lastSeen: j['last_seen'] == null
+            ? null
+            : DateTime.tryParse(j['last_seen'].toString())?.toLocal(),
+        unattended: j['unattended'] == true,
+        ip: (j['ip'] ?? '').toString(),
+        build: (j['build'] as num?)?.toInt() ?? 0,
+      );
+
+  String get lastSeenText {
+    if (online) return 'Now';
+    final t = lastSeen;
+    if (t == null) return 'Never';
+    final d = DateTime.now().difference(t);
+    if (d.inMinutes < 1) return 'Just now';
+    if (d.inMinutes < 60) return '${d.inMinutes} min ago';
+    if (d.inHours < 24) return '${d.inHours} h ago';
+    if (d.inDays == 1) return 'Yesterday';
+    return '${d.inDays} days ago';
+  }
+}
+
+class RdScript {
+  final int id;
+  final String name;
+  final String shell;
+  RdScript(this.id, this.name, this.shell);
+}
+
+class RdRun {
+  final String status;
+  final int? exitCode;
+  final String output;
+  RdRun(this.status, this.exitCode, this.output);
+  bool get finished =>
+      status == 'success' ||
+      status == 'failed' ||
+      status == 'expired' ||
+      status == 'cancelled';
+}
+
+class RdApi {
+  RdApi._();
+
+  static const unassigned = 'Unassigned';
+
+  static String get token => bind.mainGetLocalOption(key: 'access_token');
+
+  static Future<dynamic> _send(String method, String path,
+      {Object? body}) async {
+    final base = await bind.mainGetApiServer();
+    final uri = Uri.parse('$base$path');
+    final headers = getHttpHeaders();
+    headers['Content-Type'] = 'application/json';
+    final resp = method == 'GET'
+        ? await http.get(uri, headers: headers)
+        : await http.post(uri,
+            headers: headers, body: body == null ? null : jsonEncode(body));
+    final text = decode_http_response(resp);
+    dynamic data;
+    try {
+      data = text.isEmpty ? null : jsonDecode(text);
+    } catch (_) {
+      data = null;
+    }
+    if (resp.statusCode != 200) {
+      final msg = (data is Map && data['error'] != null)
+          ? data['error'].toString()
+          : 'The server answered ${resp.statusCode}.';
+      throw RdApiError(resp.statusCode, msg);
+    }
+    return data;
+  }
+
+  static Future<List<RdDevice>> devices() async {
+    final data = await _send('GET', '/api/admin/devices');
+    final list = (data as List?) ?? [];
+    return list
+        .map((e) => RdDevice.fromJson(Map<String, dynamic>.from(e as Map)))
+        .toList();
+  }
+
+  static Future<List<RdScript>> scripts() async {
+    final data = await _send('GET', '/api/admin/scripts');
+    final list = (data as List?) ?? [];
+    return list.map((e) {
+      final m = Map<String, dynamic>.from(e as Map);
+      return RdScript((m['id'] as num).toInt(), (m['name'] ?? '').toString(),
+          (m['shell'] ?? '').toString());
+    }).toList();
+  }
+
+  /// Starts a job on one device; returns the job id.
+  static Future<int> runScript(String deviceId,
+      {int? scriptId, String? shell, String? body}) async {
+    final req = <String, dynamic>{
+      'devices': [deviceId]
+    };
+    if (scriptId != null) {
+      req['script_id'] = scriptId;
+    } else {
+      req['name'] = 'Run from RD viewer';
+      req['shell'] = shell ?? 'powershell';
+      req['body'] = body ?? '';
+      req['run_as'] = 'system';
+    }
+    final data = await _send('POST', '/api/admin/jobs', body: req);
+    return ((data as Map)['job']['id'] as num).toInt();
+  }
+
+  /// action: reboot, reboot-safe-mode, shutdown or logoff.
+  static Future<int> power(String deviceId, String action) async {
+    final data = await _send('POST', '/api/admin/jobs', body: {
+      'devices': [deviceId],
+      'action': action,
+    });
+    return ((data as Map)['job']['id'] as num).toInt();
+  }
+
+  static Future<RdRun?> run(int jobId) async {
+    final data = await _send('GET', '/api/admin/jobs/$jobId');
+    final runs = ((data as Map)['runs'] as List?) ?? [];
+    if (runs.isEmpty) return null;
+    final m = Map<String, dynamic>.from(runs.first as Map);
+    return RdRun((m['status'] ?? '').toString(),
+        (m['exit_code'] as num?)?.toInt(), (m['output'] ?? '').toString());
+  }
+}

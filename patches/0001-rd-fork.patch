diff --git a/client/src/rd.rs b/client/src/rd.rs
new file mode 100644
index 0000000..f88e96a
--- /dev/null
+++ b/client/src/rd.rs
@@ -0,0 +1,111 @@
+//! RD fork additions to the RustDesk client.
+//!
+//! Upstream files only get one-line hooks marked `// RD:` that call into this
+//! module, so updating to a new RustDesk release stays a small merge.
+//!
+//! 1. `apply_builtin_config` bakes our server, its public key and our defaults
+//!    into the binary (upstream needs a config file signed by RustDesk Ltd).
+//! 2. `extend_sysinfo` reports a hash of the unattended-access password to our
+//!    API server, which hands it only to logged-in admins (with TOTP) via the
+//!    address book, so viewers connect without anyone knowing the password.
+//! 3. `start_agent` runs jobs from the console (see `rd/agent.rs`).
+
+use hbb_common::{
+    config::{self, Config},
+    log,
+};
+use std::collections::HashMap;
+
+#[cfg(windows)]
+mod agent;
+#[cfg(windows)]
+mod fleet;
+
+/// CI build number (`RD_BUILD`), reported so the server can roll out updates.
+const BUILD: Option<&str> = option_env!("RD_BUILD");
+
+/// `client/rd/config.json`, same format as RustDesk's custom client config:
+/// `app-name`, `default-settings`, `override-settings`, plus hard settings.
+const BUILTIN_CONFIG: &str = include_str!("../rd/config.json");
+
+/// Build-time overrides, set by CI from repository variables/secrets.
+const ENV_SERVER: Option<&str> = option_env!("RD_SERVER");
+const ENV_SERVER_KEY: Option<&str> = option_env!("RD_SERVER_KEY");
+
+pub fn apply_builtin_config() {
+    let mut data: HashMap<String, serde_json::Value> = match serde_json::from_str(BUILTIN_CONFIG) {
+        Ok(d) => d,
+        Err(e) => {
+            log::error!("RD: built-in config is invalid: {}", e);
+            return;
+        }
+    };
+    if let Some(serde_json::Value::Object(overrides)) = data.get_mut("override-settings") {
+        if let Some(server) = ENV_SERVER.filter(|s| !s.is_empty()) {
+            overrides.insert("custom-rendezvous-server".into(), server.into());
+            overrides.insert("relay-server".into(), server.into());
+            overrides.insert("api-server".into(), format!("https://{}", server).into());
+        }
+        if let Some(key) = ENV_SERVER_KEY.filter(|s| !s.is_empty()) {
+            overrides.insert("key".into(), key.into());
+        }
+    }
+    crate::common::apply_custom_client_map(data);
+}
+
+/// Adds `rd_pw_h1` (base64 of sha256(permanent password + salt)) to the
+/// sysinfo upload. Only the hash leaves the machine, never the password.
+///
+/// Also adds `rd_pk`, the device's public Ed25519 key, which the server records
+/// once after enrolment to verify signed agent requests (job polling).
+pub fn extend_sysinfo(v: &mut serde_json::Value) {
+    let h1 = unattended_h1().map(crate::encode64);
+    if let Some(h1) = h1.as_ref() {
+        v["rd_pw_h1"] = serde_json::json!(h1);
+    }
+    *LAST_H1.lock().unwrap() = Some(h1);
+    if let Some(b) = BUILD.filter(|b| !b.is_empty()) {
+        v["rd_build"] = serde_json::json!(b);
+    }
+    let (_, pk) = Config::get_key_pair();
+    if pk.len() == 32 {
+        v["rd_pk"] = serde_json::json!(crate::encode64(pk));
+    }
+}
+
+/// The hash last put into a sysinfo upload (`None` before the first upload).
+static LAST_H1: std::sync::Mutex<Option<Option<String>>> = std::sync::Mutex::new(None);
+
+/// True when the permanent password changed since the last sysinfo upload,
+/// so the sync loop uploads again instead of keeping a stale hash on the server.
+pub fn pw_hash_changed() -> bool {
+    match LAST_H1.lock().unwrap().as_ref() {
+        None => false,
+        Some(last) => *last != unattended_h1().map(crate::encode64),
+    }
+}
+
+fn unattended_h1() -> Option<Vec<u8>> {
+    let (storage, salt) = Config::get_local_permanent_password_storage_and_salt();
+    if storage.is_empty() || salt.is_empty() {
+        return None;
+    }
+    config::decode_permanent_password_h1_from_storage(&storage).map(|h1| h1.to_vec())
+}
+
+/// Starts the job runner (scripts and power actions from the RD console) in
+/// the installed Windows service.
+pub fn start_agent() {
+    #[cfg(windows)]
+    agent::start();
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn builtin_config_parses() {
+        let v: serde_json::Value = serde_json::from_str(super::BUILTIN_CONFIG).unwrap();
+        assert!(v["override-settings"]["custom-rendezvous-server"].is_string());
+        assert_eq!(v["override-settings"]["allow-websocket"], "Y");
+    }
+}
diff --git a/client/src/rd/agent.rs b/client/src/rd/agent.rs
new file mode 100644
index 0000000..76a2110
--- /dev/null
+++ b/client/src/rd/agent.rs
@@ -0,0 +1,458 @@
+//! RD job runner (Windows service only).
+//!
+//! Polls the RD API server for jobs, runs scripts and power actions, and
+//! reports the result. Both directions are signed:
+//! - requests are signed with this device's RustDesk Ed25519 key, which the
+//!   server recorded from the first sysinfo after enrolment;
+//! - each job is signed by the server's job key, built into the client
+//!   (`client/rd/job-key.pub`). Unsigned or foreign jobs are never run.
+//!
+//! The protocol matches `server/internal/api/jobs.go`.
+
+use hbb_common::{config::Config, log, sodiumoxide::crypto::sign};
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use std::{
+    io::Read,
+    os::windows::process::CommandExt,
+    path::PathBuf,
+    process::{Command, Stdio},
+    sync::Once,
+    thread,
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+const JOB_KEY: &str = include_str!("../../rd/job-key.pub");
+const ENV_JOB_KEY: Option<&str> = option_env!("RD_JOB_KEY");
+const MAX_OUTPUT: usize = 256 * 1024;
+pub(super) const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+static START: Once = Once::new();
+
+pub fn start() {
+    START.call_once(|| {
+        if !crate::platform::is_installed() {
+            return;
+        }
+        let Some(key) = job_key() else {
+            log::error!("RD agent: no valid job key built in, job runner disabled");
+            return;
+        };
+        thread::spawn(move || run(key));
+        super::fleet::cleanup_update();
+        super::fleet::enable_rdp_session_picker();
+        super::fleet::start_inventory();
+        super::fleet::start_sync();
+    });
+}
+
+fn job_key() -> Option<sign::PublicKey> {
+    let b64 = ENV_JOB_KEY
+        .filter(|s| !s.is_empty())
+        .unwrap_or(JOB_KEY)
+        .trim();
+    let bytes = crate::decode64(b64).ok()?;
+    sign::PublicKey::from_slice(&bytes)
+}
+
+pub(super) fn now() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs() as i64)
+        .unwrap_or_default()
+}
+
+pub(super) fn device_sign(msg: &str) -> Option<String> {
+    let (sk, _) = Config::get_key_pair();
+    let sk = sign::SecretKey::from_slice(&sk)?;
+    Some(crate::encode64(
+        sign::sign_detached(msg.as_bytes(), &sk).to_bytes(),
+    ))
+}
+
+#[derive(Deserialize)]
+struct PollResponse {
+    #[serde(default)]
+    jobs: Vec<SignedJob>,
+    #[serde(default)]
+    poll_after: u64,
+    #[serde(default)]
+    error: String,
+}
+
+#[derive(Deserialize)]
+struct SignedJob {
+    payload: String,
+    sig: String,
+}
+
+#[derive(Deserialize)]
+struct Job {
+    job_id: i64,
+    device_id: String,
+    kind: String,
+    #[serde(default)]
+    shell: String,
+    #[serde(default)]
+    body: String,
+    #[serde(default)]
+    run_as: String,
+    timeout_sec: u64,
+    #[serde(default)]
+    action: String,
+    expires_at: i64,
+}
+
+fn run(key: sign::PublicKey) {
+    // Give the service time to register and upload sysinfo (which carries our key).
+    thread::sleep(Duration::from_secs(20));
+    loop {
+        let wait = match poll_once(&key) {
+            Ok(after) => after.clamp(5, 300),
+            Err(e) => {
+                hbb_common::throttled_log!(
+                    Duration::from_secs(600),
+                    warn,
+                    "RD agent poll failed: {}",
+                    e
+                );
+                60
+            }
+        };
+        thread::sleep(Duration::from_secs(wait));
+    }
+}
+
+pub(super) fn api() -> String {
+    crate::ui_interface::get_api_server()
+}
+
+fn poll_once(key: &sign::PublicKey) -> Result<u64, String> {
+    let url = api();
+    if url.is_empty() {
+        return Ok(60);
+    }
+    let id = Config::get_id();
+    let ts = now().to_string();
+    let sig = device_sign(&format!("rd-poll\n{}\n{}", id, ts)).ok_or("no device key")?;
+    let body = serde_json::json!({ "id": id, "ts": ts, "sig": sig }).to_string();
+    let text = crate::post_request_sync(format!("{}/api/agent/poll", url), body, "")
+        .map_err(|e| e.to_string())?;
+    let resp: PollResponse =
+        serde_json::from_str(&text).map_err(|e| format!("bad response: {}", e))?;
+    if !resp.error.is_empty() {
+        return Err(resp.error);
+    }
+    for sj in resp.jobs {
+        match verify(key, &sj, &id) {
+            Ok(job) => execute(job, &id),
+            Err(e) => log::error!("RD agent: rejected job: {}", e),
+        }
+    }
+    Ok(if resp.poll_after == 0 {
+        10
+    } else {
+        resp.poll_after
+    })
+}
+
+fn verify(key: &sign::PublicKey, sj: &SignedJob, id: &str) -> Result<Job, String> {
+    let sig = crate::decode64(&sj.sig).map_err(|_| "signature is not base64")?;
+    let sig: [u8; 64] = sig
+        .try_into()
+        .map_err(|_| "signature has the wrong length")?;
+    let sig = sign::Signature::from_bytes(&sig).map_err(|_| "invalid signature")?;
+    if !sign::verify_detached(&sig, sj.payload.as_bytes(), key) {
+        return Err("signature does not match the built-in job key".into());
+    }
+    let job: Job = serde_json::from_str(&sj.payload).map_err(|e| format!("bad payload: {}", e))?;
+    if job.device_id != id {
+        return Err(format!(
+            "job {} is for device {}, not this one",
+            job.job_id, job.device_id
+        ));
+    }
+    if now() > job.expires_at + 300 {
+        return Err(format!("job {} has expired", job.job_id));
+    }
+    Ok(job)
+}
+
+fn execute(job: Job, id: &str) {
+    log::info!("RD agent: running job {} ({})", job.job_id, job.kind);
+    let (ok, code, output) = match job.kind.as_str() {
+        "script" if job.run_as == "user" => (
+            false,
+            -1,
+            "Running as the logged-on user is not supported by this client version yet. Use SYSTEM.".to_owned(),
+        ),
+        "script" => run_script(&job),
+        "power" => {
+            // Report first: the machine may be gone a few seconds later.
+            let (ok, code, out) = prepare_power(&job.action);
+            report(id, job.job_id, ok, code, &out);
+            if ok {
+                start_power(&job.action);
+            }
+            return;
+        }
+        "update" => {
+            match super::fleet::prepare_update(&job.body) {
+                Ok((build, exe)) => {
+                    // Report first: the update stops this service.
+                    report(
+                        id,
+                        job.job_id,
+                        true,
+                        0,
+                        &format!("Updating to build {}. The RD service restarts in a moment.", build),
+                    );
+                    super::fleet::start_update(&exe);
+                }
+                Err(e) => report(id, job.job_id, false, -1, &e),
+            }
+            return;
+        }
+        other => (false, -1, format!("Unknown job kind {}", other)),
+    };
+    report(id, job.job_id, ok, code, &output);
+}
+
+fn jobs_dir() -> PathBuf {
+    let base = std::env::var("ProgramData").unwrap_or_else(|_| "C:\\ProgramData".to_owned());
+    PathBuf::from(base).join("RD").join("jobs")
+}
+
+fn run_script(job: &Job) -> (bool, i32, String) {
+    let dir = jobs_dir();
+    if let Err(e) = std::fs::create_dir_all(&dir) {
+        return (false, -1, format!("Cannot create {}: {}", dir.display(), e));
+    }
+    let (file, mut cmd) = if job.shell == "cmd" {
+        let f = dir.join(format!("job-{}.cmd", job.job_id));
+        let mut c = Command::new("cmd.exe");
+        c.arg("/d").arg("/c").arg(&f);
+        (f, c)
+    } else {
+        let f = dir.join(format!("job-{}.ps1", job.job_id));
+        let mut c = Command::new("powershell.exe");
+        c.args([
+            "-NoLogo",
+            "-NoProfile",
+            "-NonInteractive",
+            "-ExecutionPolicy",
+            "Bypass",
+            "-File",
+        ])
+        .arg(&f);
+        (f, c)
+    };
+    let script = if job.shell == "cmd" {
+        format!("@chcp 65001 >nul\r\n{}", job.body)
+    } else {
+        // UTF-8 BOM so PowerShell 5.1 reads non-ASCII correctly; UTF-8 output.
+        format!(
+            "\u{feff}[Console]::OutputEncoding = [System.Text.Encoding]::UTF8\r\n$ProgressPreference = 'SilentlyContinue'\r\n{}",
+            job.body
+        )
+    };
+    if let Err(e) = std::fs::write(&file, script) {
+        return (false, -1, format!("Cannot write {}: {}", file.display(), e));
+    }
+    let result = run_with_timeout(&mut cmd, Duration::from_secs(job.timeout_sec.max(1)));
+    std::fs::remove_file(&file).ok();
+    result
+}
+
+pub(super) fn run_with_timeout(cmd: &mut Command, timeout: Duration) -> (bool, i32, String) {
+    cmd.stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .creation_flags(CREATE_NO_WINDOW);
+    let mut child = match cmd.spawn() {
+        Ok(c) => c,
+        Err(e) => return (false, -1, format!("Failed to start: {}", e)),
+    };
+    let reader = |r: Option<Box<dyn Read + Send>>| {
+        thread::spawn(move || {
+            let mut buf = Vec::new();
+            if let Some(mut r) = r {
+                r.take((MAX_OUTPUT + 1) as u64).read_to_end(&mut buf).ok();
+            }
+            buf
+        })
+    };
+    let out = reader(
+        child
+            .stdout
+            .take()
+            .map(|s| Box::new(s) as Box<dyn Read + Send>),
+    );
+    let err = reader(
+        child
+            .stderr
+            .take()
+            .map(|s| Box::new(s) as Box<dyn Read + Send>),
+    );
+    let start = Instant::now();
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(s)) => break Some(s),
+            Ok(None) if start.elapsed() >= timeout => {
+                child.kill().ok();
+                child.wait().ok();
+                break None;
+            }
+            Ok(None) => thread::sleep(Duration::from_millis(250)),
+            Err(_) => break None,
+        }
+    };
+    let mut text = String::from_utf8_lossy(&out.join().unwrap_or_default()).into_owned();
+    let stderr = String::from_utf8_lossy(&err.join().unwrap_or_default()).into_owned();
+    if !stderr.trim().is_empty() {
+        if !text.is_empty() && !text.ends_with('\n') {
+            text.push('\n');
+        }
+        text.push_str(&stderr);
+    }
+    match status {
+        Some(s) => {
+            let code = s.code().unwrap_or(-1);
+            (code == 0, code, text)
+        }
+        None => {
+            text.push_str(&format!(
+                "\n[stopped after the {} s timeout]",
+                timeout.as_secs()
+            ));
+            (false, -1, text)
+        }
+    }
+}
+
+fn report(id: &str, job_id: i64, ok: bool, code: i32, output: &str) {
+    let mut output = output.to_owned();
+    if output.len() > MAX_OUTPUT {
+        let mut cut = MAX_OUTPUT;
+        while !output.is_char_boundary(cut) {
+            cut -= 1;
+        }
+        output.truncate(cut);
+        output.push_str("\n[output truncated]");
+    }
+    let status = if ok { "success" } else { "failed" };
+    let ts = now().to_string();
+    let hash: String = Sha256::digest(output.as_bytes())
+        .iter()
+        .map(|b| format!("{:02x}", b))
+        .collect();
+    let msg = format!(
+        "rd-result\n{}\n{}\n{}\n{}\n{}\n{}",
+        id, job_id, status, code, hash, ts
+    );
+    let Some(sig) = device_sign(&msg) else {
+        log::error!("RD agent: cannot sign result for job {}", job_id);
+        return;
+    };
+    let body = serde_json::json!({
+        "id": id, "ts": ts, "job_id": job_id, "status": status,
+        "exit_code": code, "output": output, "sig": sig,
+    })
+    .to_string();
+    for attempt in 0..3 {
+        match crate::post_request_sync(format!("{}/api/agent/result", api()), body.clone(), "") {
+            Ok(_) => return,
+            Err(e) => {
+                log::warn!(
+                    "RD agent: result for job {} not sent (attempt {}): {}",
+                    job_id,
+                    attempt + 1,
+                    e
+                );
+                thread::sleep(Duration::from_secs(10));
+            }
+        }
+    }
+}
+
+/// Validates the action and does the reversible preparation; nothing restarts yet.
+fn prepare_power(action: &str) -> (bool, i32, String) {
+    match action {
+        "reboot" => (true, 0, "Restarting in 10 seconds.".into()),
+        "shutdown" => (true, 0, "Shutting down in 10 seconds.".into()),
+        "logoff" => (true, 0, "Logging off the console user.".into()),
+        "reboot-safe-mode" => {
+            let svc = hbb_common::config::APP_NAME
+                .read()
+                .map(|n| n.clone())
+                .unwrap_or_default();
+            // Boot into Safe Mode with networking once: the RunOnce entry (the * prefix runs it in
+            // Safe Mode too) clears the flag again, and our service is allowed to start in Safe Mode.
+            let script = format!(
+                "$ErrorActionPreference = 'Stop'\r\n\
+                 bcdedit /set '{{current}}' safeboot network | Out-Null\r\n\
+                 New-Item -Force 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SafeBoot\\Network\\{svc}' -Value 'Service' | Out-Null\r\n\
+                 Set-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce' -Name '*RDClearSafeBoot' -Value 'bcdedit /deletevalue {{current}} safeboot'\r\n\
+                 'Safe Mode with networking set for the next boot only. Restarting in 10 seconds.'"
+            );
+            let mut cmd = Command::new("powershell.exe");
+            cmd.args([
+                "-NoLogo",
+                "-NoProfile",
+                "-NonInteractive",
+                "-Command",
+                &script,
+            ]);
+            run_with_timeout(&mut cmd, Duration::from_secs(60))
+        }
+        other => (false, -1, format!("Unknown power action {}", other)),
+    }
+}
+
+fn start_power(action: &str) {
+    let mut cmd = match action {
+        "reboot" | "reboot-safe-mode" => {
+            let mut c = Command::new("shutdown.exe");
+            c.args([
+                "/r",
+                "/f",
+                "/t",
+                "10",
+                "/d",
+                "p:0:0",
+                "/c",
+                "Restart requested from RD",
+            ]);
+            c
+        }
+        "shutdown" => {
+            let mut c = Command::new("shutdown.exe");
+            c.args([
+                "/s",
+                "/f",
+                "/t",
+                "10",
+                "/d",
+                "p:0:0",
+                "/c",
+                "Shutdown requested from RD",
+            ]);
+            c
+        }
+        "logoff" => {
+            let mut c = Command::new("powershell.exe");
+            c.args([
+                "-NoLogo",
+                "-NoProfile",
+                "-NonInteractive",
+                "-Command",
+                "$s = (Get-CimInstance Win32_Process -Filter \"Name='explorer.exe'\" | Select-Object -First 1).SessionId; if ($s) { logoff $s }",
+            ]);
+            c
+        }
+        _ => return,
+    };
+    if let Err(e) = cmd.creation_flags(CREATE_NO_WINDOW).spawn() {
+        log::error!("RD agent: {} failed to start: {}", action, e);
+    }
+}
diff --git a/client/src/rd/fleet.rs b/client/src/rd/fleet.rs
new file mode 100644
index 0000000..656c8e5
--- /dev/null
+++ b/client/src/rd/fleet.rs
@@ -0,0 +1,263 @@
+//! Inventory reports and self-update (Windows service only).
+//!
+//! - Inventory: `inventory.ps1` a few minutes after start and every 6 hours,
+//!   posted to `/api/agent/inventory` signed with the device key.
+//! - Update: an "update" job (signed by the server's job key, see agent.rs)
+//!   names a release zip and its SHA-256. The zip is downloaded, checked,
+//!   unpacked, and `RD.exe --update` from it is started through Task
+//!   Scheduler, because that command stops this service.
+//!
+//! The protocol matches `server/internal/api/fleet.go`.
+
+use super::agent::{api, device_sign, now, run_with_timeout, CREATE_NO_WINDOW};
+use hbb_common::{config::Config, log};
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use std::{
+    os::windows::process::CommandExt,
+    path::{Path, PathBuf},
+    process::Command,
+    thread,
+    time::Duration,
+};
+
+const INVENTORY_SCRIPT: &str = include_str!("inventory.ps1");
+const INVENTORY_FIRST: Duration = Duration::from_secs(180);
+const INVENTORY_EVERY: Duration = Duration::from_secs(6 * 3600);
+const TASK_NAME: &str = "RD-Update";
+const SYNC_SCRIPT: &str = include_str!("syncthing.ps1");
+const SYNC_FIRST: Duration = Duration::from_secs(90);
+const SYNC_EVERY: Duration = Duration::from_secs(300);
+
+pub fn start_inventory() {
+    thread::spawn(|| {
+        thread::sleep(INVENTORY_FIRST);
+        loop {
+            if let Err(e) = send_inventory() {
+                log::warn!("RD agent: inventory not sent: {}", e);
+            }
+            thread::sleep(INVENTORY_EVERY);
+        }
+    });
+}
+
+/// Syncthing status every 5 minutes; see syncthing.ps1 and server/internal/api/sync.go.
+pub fn start_sync() {
+    thread::spawn(|| {
+        thread::sleep(SYNC_FIRST);
+        loop {
+            if let Err(e) = send_sync() {
+                log::warn!("RD agent: Syncthing status not sent: {}", e);
+            }
+            thread::sleep(SYNC_EVERY);
+        }
+    });
+}
+
+fn send_sync() -> Result<(), String> {
+    let url = api();
+    if url.is_empty() {
+        return Ok(());
+    }
+    let (ok, code, out) = powershell(SYNC_SCRIPT, Duration::from_secs(120));
+    if !ok {
+        return Err(format!("syncthing script exited with {}", code));
+    }
+    let report = out.trim().to_owned();
+    serde_json::from_str::<serde_json::Value>(&report)
+        .map_err(|e| format!("Syncthing report is not JSON: {}", e))?;
+    let id = Config::get_id();
+    let ts = now().to_string();
+    let msg = format!(
+        "rd-sync\n{}\n{}\n{}",
+        id,
+        hex(&Sha256::digest(report.as_bytes())),
+        ts
+    );
+    let sig = device_sign(&msg).ok_or("no device key")?;
+    let body = serde_json::json!({ "id": id, "ts": ts, "report": report, "sig": sig }).to_string();
+    crate::post_request_sync(format!("{}/api/agent/sync", url), body, "")
+        .map(|_| ())
+        .map_err(|e| e.to_string())
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{:02x}", x)).collect()
+}
+
+fn powershell(script: &str, timeout: Duration) -> (bool, i32, String) {
+    let mut cmd = Command::new("powershell.exe");
+    cmd.args([
+        "-NoLogo",
+        "-NoProfile",
+        "-NonInteractive",
+        "-ExecutionPolicy",
+        "Bypass",
+        "-Command",
+        script,
+    ]);
+    run_with_timeout(&mut cmd, timeout)
+}
+
+fn send_inventory() -> Result<(), String> {
+    let url = api();
+    if url.is_empty() {
+        return Ok(());
+    }
+    let (ok, code, out) = powershell(INVENTORY_SCRIPT, Duration::from_secs(300));
+    if !ok {
+        return Err(format!("inventory script exited with {}", code));
+    }
+    let inventory = out.trim().to_owned();
+    serde_json::from_str::<serde_json::Value>(&inventory)
+        .map_err(|e| format!("inventory is not JSON: {}", e))?;
+    let id = Config::get_id();
+    let ts = now().to_string();
+    let msg = format!(
+        "rd-inventory\n{}\n{}\n{}",
+        id,
+        hex(&Sha256::digest(inventory.as_bytes())),
+        ts
+    );
+    let sig = device_sign(&msg).ok_or("no device key")?;
+    let body = serde_json::json!({ "id": id, "ts": ts, "inventory": inventory, "sig": sig })
+        .to_string();
+    crate::post_request_sync(format!("{}/api/agent/inventory", url), body, "")
+        .map(|_| ())
+        .map_err(|e| e.to_string())
+}
+
+#[derive(Deserialize)]
+struct UpdateBody {
+    build: i64,
+    path: String,
+    sha256: String,
+}
+
+fn update_dir() -> PathBuf {
+    let base = std::env::var("ProgramData").unwrap_or_else(|_| "C:\\ProgramData".to_owned());
+    PathBuf::from(base).join("RD").join("update")
+}
+
+fn ps_quote(p: &Path) -> String {
+    format!("'{}'", p.display().to_string().replace('\'', "''"))
+}
+
+fn file_sha256(path: &Path) -> Result<String, String> {
+    let mut f = std::fs::File::open(path).map_err(|e| e.to_string())?;
+    let mut h = Sha256::new();
+    std::io::copy(&mut f, &mut h).map_err(|e| e.to_string())?;
+    Ok(hex(&h.finalize()))
+}
+
+/// Downloads, checks and unpacks the release; returns RD.exe of the new build.
+pub fn prepare_update(body: &str) -> Result<(i64, PathBuf), String> {
+    let u: UpdateBody = serde_json::from_str(body).map_err(|e| format!("bad update job: {}", e))?;
+    if !u.path.starts_with("/api/releases/") || u.sha256.len() != 64 {
+        return Err("bad update job".into());
+    }
+    let dir = update_dir();
+    std::fs::remove_dir_all(&dir).ok();
+    std::fs::create_dir_all(&dir).map_err(|e| format!("cannot create {}: {}", dir.display(), e))?;
+    let zip = dir.join(format!("rd-{}.zip", u.build));
+    let unpacked = dir.join(format!("rd-{}", u.build));
+    let url = format!("{}{}", api(), u.path).replace('\'', "''");
+    let (ok, _, out) = powershell(
+        &format!(
+            "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; \
+             [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; \
+             Invoke-WebRequest -UseBasicParsing -Uri '{}' -OutFile {}",
+            url,
+            ps_quote(&zip)
+        ),
+        Duration::from_secs(600),
+    );
+    if !ok {
+        return Err(format!("download failed: {}", out.trim()));
+    }
+    let got = file_sha256(&zip)?;
+    if !got.eq_ignore_ascii_case(&u.sha256) {
+        std::fs::remove_file(&zip).ok();
+        return Err(format!(
+            "download does not match the signed SHA-256 ({} instead of {})",
+            got, u.sha256
+        ));
+    }
+    let (ok, _, out) = powershell(
+        &format!(
+            "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; \
+             Expand-Archive -LiteralPath {} -DestinationPath {} -Force",
+            ps_quote(&zip),
+            ps_quote(&unpacked)
+        ),
+        Duration::from_secs(300),
+    );
+    if !ok {
+        return Err(format!("unpacking failed: {}", out.trim()));
+    }
+    let exe = find_exe(&unpacked).ok_or("the release has no RD.exe")?;
+    Ok((u.build, exe))
+}
+
+fn find_exe(dir: &Path) -> Option<PathBuf> {
+    for entry in std::fs::read_dir(dir).ok()?.flatten() {
+        let p = entry.path();
+        if p.is_dir() {
+            if let Some(f) = find_exe(&p) {
+                return Some(f);
+            }
+        } else if p
+            .file_name()
+            .map(|n| n.eq_ignore_ascii_case("RD.exe"))
+            .unwrap_or(false)
+        {
+            return Some(p);
+        }
+    }
+    None
+}
+
+/// Runs `RD.exe --update` from the new build outside this service's process
+/// tree: it stops the service, copies itself over the install and restarts it.
+pub fn start_update(exe: &Path) {
+    let tr = format!("\"{}\" --update", exe.display());
+    let create = Command::new("schtasks.exe")
+        .args([
+            "/Create", "/F", "/TN", TASK_NAME, "/RU", "SYSTEM", "/RL", "HIGHEST", "/SC", "ONCE",
+            "/ST", "00:00", "/TR",
+        ])
+        .arg(&tr)
+        .creation_flags(CREATE_NO_WINDOW)
+        .status();
+    if !matches!(create, Ok(s) if s.success()) {
+        log::error!("RD agent: cannot create the update task: {:?}", create);
+        return;
+    }
+    if let Err(e) = Command::new("schtasks.exe")
+        .args(["/Run", "/TN", TASK_NAME])
+        .creation_flags(CREATE_NO_WINDOW)
+        .status()
+    {
+        log::error!("RD agent: cannot start the update task: {}", e);
+    }
+}
+
+/// After an update the service runs again: remove the one-shot task and files.
+pub fn cleanup_update() {
+    Command::new("schtasks.exe")
+        .args(["/Delete", "/F", "/TN", TASK_NAME])
+        .creation_flags(CREATE_NO_WINDOW)
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .ok();
+    std::fs::remove_dir_all(update_dir()).ok();
+}
+
+/// The RDP session picker in sessions needs RustDesk's "share RDP" setting.
+pub fn enable_rdp_session_picker() {
+    if !crate::platform::is_share_rdp() {
+        crate::platform::set_share_rdp(true);
+        log::info!("RD agent: enabled RDP session sharing (session picker)");
+    }
+}
